# Copia este archivo a .env y completa los valores.
# Nunca subas .env al repositorio.

# TMDB — Read Access Token (v4) desde https://www.themoviedb.org/settings/api
# ADVERTENCIA: cualquier VITE_* se embebe en el JS del navegador.
# En producción preferir proxy (ver abajo) y dejar VITE_TMDB_TOKEN vacío.
VITE_TMDB_TOKEN=

# URL base del proxy serverless (ej. /api/tmdb en Vercel).
# Si está definida, el cliente llama al proxy en lugar de api.themoviedb.org
# y el token vive solo en el servidor como TMDB_TOKEN.
VITE_TMDB_PROXY=

# Solo en el hosting / función serverless (NO uses prefijo VITE_):
# TMDB_TOKEN=

# Google Books — API key de Google Cloud (Books API habilitada)
# También se expone al cliente; para demo académica documentamos el riesgo.
VITE_GOOGLE_BOOKS_KEY=
